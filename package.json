{
  "name": "medical-bi-designer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --configLoader runner",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && vite build --configLoader runner",
    "preview": "vite preview",
    "start:api": "node scripts/start-api.mjs",
    "test:phase1": "node --experimental-strip-types --test tests/phase1-query-result.test.ts",
    "test": "node scripts/run-tests.mjs",
    "test:local": "node scripts/run-tests.mjs --local",
    "test:all": "node scripts/run-tests.mjs --all",
    "test:outpatient": "node scripts/verify-outpatient-flow.mjs",
    "test:mobile-model": "node scripts/verify-mobile-model-flow.mjs",
    "test:product-mobile": "node scripts/verify-product-mobile.mjs",
    "test:composition": "node scripts/verify-component-composition.mjs",
    "test:query-cancellation": "node scripts/verify-query-cancellation.mjs",
    "test:department": "node scripts/verify-department-performance.mjs",
    "benchmark:display": "node scripts/benchmark-local-display.mjs",
    "demo:hospital": "node scripts/generate-hospital-operations-demo.mjs",
    "test:e2e": "node scripts/test-e2e.mjs",
    "verify:node": "node scripts/verify-node.mjs",
    "verify:full": "node scripts/verify-node.mjs --full"
  },
  "dependencies": {
    "@tabler/core": "^1.4.0",
    "@tabler/icons-vue": "^3.34.1",
    "ajv": "^8.20.0",
    "echarts": "^6.0.0",
    "leaflet": "^1.9.4",
    "pg": "^8.22.0",
    "vue": "^3.5.21",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/leaflet": "^1.9.22",
    "@vitejs/plugin-vue": "^6.0.1",
    "typescript": "~5.9.2",
    "vite": "^7.1.7",
    "vue-tsc": "^3.0.8"
  }
}
