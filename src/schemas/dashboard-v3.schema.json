{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://medical-bi-designer.local/schemas/dashboard-v3.schema.json",
  "title": "Medical BI Designer Dashboard Application V3",
  "type": "object",
  "required": ["version", "id", "name", "defaultPageId", "parameters", "pages", "theme", "runtimePolicy", "extensionRefs"],
  "properties": {
    "version": { "const": 3 },
    "id": { "$ref": "#/$defs/nonEmptyString" },
    "name": { "$ref": "#/$defs/nonEmptyString" },
    "description": { "type": "string" },
    "defaultPageId": { "$ref": "#/$defs/nonEmptyString" },
    "parameters": { "type": "array", "items": { "$ref": "#/$defs/parameter" } },
    "pages": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/page" } },
    "theme": { "$ref": "#/$defs/theme" },
    "runtimePolicy": { "$ref": "#/$defs/runtimePolicy" },
    "extensionRefs": { "$ref": "#/$defs/extensionRefs" },
    "publishConfig": { "$ref": "#/$defs/publishConfig" },
    "createdAt": { "type": "string" },
    "updatedAt": { "type": "string" },
    "activePageId": false
  },
  "additionalProperties": true,
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "canvas": {
      "type": "object",
      "required": ["width", "height", "background", "showGrid", "gridSize"],
      "properties": {
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "background": { "type": "string" },
        "showGrid": { "type": "boolean" },
        "gridSize": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": true
    },
    "titleStyle": {
      "type": "object",
      "required": ["show", "fontSize", "color", "fontWeight", "align"],
      "properties": {
        "show": { "type": "boolean" },
        "fontSize": { "type": "number", "exclusiveMinimum": 0 },
        "color": { "type": "string" },
        "fontWeight": { "type": "number" },
        "align": { "enum": ["left", "center", "right"] }
      },
      "additionalProperties": true
    },
    "page": {
      "type": "object",
      "required": ["id", "name", "code", "order", "type", "canvas", "titleStyle", "controls", "components", "pageEvents"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "code": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "order": { "type": "integer", "minimum": 1 },
        "type": { "enum": ["standard", "dialog"] },
        "canvas": { "$ref": "#/$defs/canvas" },
        "titleStyle": { "$ref": "#/$defs/titleStyle" },
        "controls": { "type": "array", "items": { "$ref": "#/$defs/parameterControl" } },
        "components": { "type": "array", "items": { "$ref": "#/$defs/component" } },
        "pageEvents": { "type": "array", "items": { "$ref": "#/$defs/eventBinding" } }
      },
      "additionalProperties": true
    },
    "component": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "events": { "type": "array", "items": { "$ref": "#/$defs/eventBinding" } }
      },
      "additionalProperties": true
    },
    "valueExpression": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "parameterId"],
          "properties": {
            "kind": { "const": "parameter" },
            "parameterId": { "$ref": "#/$defs/nonEmptyString" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "path"],
          "properties": {
            "kind": { "const": "eventField" },
            "path": { "$ref": "#/$defs/nonEmptyString" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "fixed" },
            "value": { "$ref": "#/$defs/jsonValue" }
          },
          "additionalProperties": false
        }
      ]
    },
    "jsonValue": {
      "anyOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        { "type": "array", "items": { "$ref": "#/$defs/jsonValue" } },
        { "type": "object", "additionalProperties": { "$ref": "#/$defs/jsonValue" } }
      ]
    },
    "eventCondition": {
      "type": "object",
      "required": ["left", "operator"],
      "properties": {
        "left": { "$ref": "#/$defs/valueExpression" },
        "operator": { "enum": ["eq", "ne", "in", "notIn", "isEmpty", "notEmpty"] },
        "right": { "$ref": "#/$defs/valueExpression" }
      },
      "additionalProperties": false
    },
    "setParameterAction": {
      "type": "object",
      "required": ["id", "type", "assignments"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "type": { "const": "setParameter" },
        "assignments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["parameterId", "value"],
            "properties": {
              "parameterId": { "$ref": "#/$defs/nonEmptyString" },
              "value": { "$ref": "#/$defs/valueExpression" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "refreshAction": {
      "type": "object",
      "required": ["id", "type", "target"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "type": { "const": "refresh" },
        "target": {
          "oneOf": [
            {
              "type": "object",
              "required": ["kind", "componentIds"],
              "properties": {
                "kind": { "const": "components" },
                "componentIds": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "$ref": "#/$defs/nonEmptyString" },
                  "uniqueItems": true
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": ["kind", "pageId"],
              "properties": {
                "kind": { "const": "page" },
                "pageId": { "$ref": "#/$defs/nonEmptyString" }
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "actionDefinition": {
      "oneOf": [
        { "$ref": "#/$defs/setParameterAction" },
        { "$ref": "#/$defs/refreshAction" }
      ]
    },
    "eventBinding": {
      "type": "object",
      "required": ["id", "enabled", "event", "actions"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "enabled": { "type": "boolean" },
        "event": { "enum": ["click", "doubleClick", "valueChange", "rowClick", "pageEnter"] },
        "conditions": { "type": "array", "items": { "$ref": "#/$defs/eventCondition" } },
        "actions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/actionDefinition" } },
        "debounceMs": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "parameterOption": {
      "type": "object",
      "required": ["label", "value"],
      "properties": {
        "label": { "$ref": "#/$defs/nonEmptyString" },
        "value": {}
      },
      "additionalProperties": false
    },
    "parameterSource": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "options"],
          "properties": {
            "kind": { "const": "static" },
            "options": { "type": "array", "items": { "$ref": "#/$defs/parameterOption" } }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "dictionaryCode"],
          "properties": {
            "kind": { "const": "dictionary" },
            "dictionaryCode": { "type": "string", "pattern": "^builtin\\.[a-z][A-Za-z0-9]*$" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "systemCode"],
          "properties": {
            "kind": { "const": "system" },
            "systemCode": { "$ref": "#/$defs/nonEmptyString" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "datasetId", "valueField", "labelField"],
          "properties": {
            "kind": { "const": "dataset" },
            "datasetId": { "$ref": "#/$defs/nonEmptyString" },
            "valueField": { "$ref": "#/$defs/nonEmptyString" },
            "labelField": { "$ref": "#/$defs/nonEmptyString" }
          },
          "additionalProperties": false
        }
      ]
    },
    "position": {
      "type": "object",
      "required": ["x", "y", "width", "height", "zIndex"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "zIndex": { "type": "number" }
      },
      "additionalProperties": false
    },
    "parameterControl": {
      "type": "object",
      "required": ["id", "type", "parameterIds", "position", "styleConfig", "interaction"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "type": { "enum": ["buttonGroup", "singleSelect", "multiSelect", "date", "dateRange"] },
        "parameterIds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmptyString" },
          "uniqueItems": true
        },
        "position": { "$ref": "#/$defs/position" },
        "styleConfig": { "type": "object" },
        "interaction": {
          "type": "object",
          "required": ["submitMode", "clearable"],
          "properties": {
            "submitMode": { "enum": ["immediate", "manual"] },
            "clearable": { "type": "boolean" },
            "cascadeFrom": {
              "type": "array",
              "items": { "$ref": "#/$defs/nonEmptyString" },
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "parameterValidation": {
      "type": "object",
      "properties": {
        "allowEmpty": { "type": "boolean" },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "pattern": { "type": "string" }
      },
      "additionalProperties": false
    },
    "parameter": {
      "type": "object",
      "required": ["id", "code", "name", "type", "scope", "required", "source"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "code": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "type": { "enum": ["string", "number", "date", "dateRange", "singleSelect", "multiSelect"] },
        "scope": { "const": "application" },
        "pageId": { "type": "string" },
        "required": { "type": "boolean" },
        "defaultValue": {},
        "source": { "$ref": "#/$defs/parameterSource" },
        "validation": { "$ref": "#/$defs/parameterValidation" },
        "aliases": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      },
      "additionalProperties": true
    },
    "theme": {
      "type": "object",
      "required": ["id", "tokens"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "tokens": { "type": "object" }
      },
      "additionalProperties": true
    },
    "runtimePolicy": {
      "type": "object",
      "required": ["previewScaleMode", "allowScroll", "parameterPersistence", "maxEventDepth"],
      "properties": {
        "previewScaleMode": { "enum": ["fit", "width", "actual"] },
        "allowScroll": { "type": "boolean" },
        "parameterPersistence": { "enum": ["none", "session", "url"] },
        "maxEventDepth": { "type": "integer", "minimum": 1, "maximum": 100 }
      },
      "additionalProperties": false
    },
    "extensionRefs": {
      "type": "object",
      "properties": {
        "permissionPolicyRef": { "type": "string" },
        "queryCachePolicyRef": { "type": "string" },
        "semanticLayerRef": { "type": "string" },
        "algorithmProviderRefs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      },
      "additionalProperties": true
    },
    "publishConfig": {
      "type": "object",
      "required": ["status", "entryPageId", "access"],
      "properties": {
        "status": { "enum": ["draft", "published", "archived"] },
        "publishedVersion": { "type": "integer", "minimum": 1 },
        "entryPageId": { "$ref": "#/$defs/nonEmptyString" },
        "access": { "enum": ["private", "authenticated", "public"] },
        "publishedAt": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
