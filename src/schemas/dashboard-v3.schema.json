{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://medical-bi-designer.local/schemas/dashboard-v3.schema.json",
  "title": "Medical BI Designer Dashboard Application V3",
  "type": "object",
  "required": ["version", "id", "name", "defaultPageId", "parameters", "pages", "theme", "runtimePolicy", "extensionRefs"],
  "properties": {
    "version": { "const": 3 },
    "id": { "$ref": "#/$defs/nonEmptyString" },
    "name": { "$ref": "#/$defs/nonEmptyString" },
    "description": { "type": "string" },
    "defaultPageId": { "$ref": "#/$defs/nonEmptyString" },
    "parameters": { "type": "array", "items": { "$ref": "#/$defs/parameter" } },
    "drillPaths": { "type": "array", "items": { "$ref": "#/$defs/drillPath" } },
    "pages": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/page" } },
    "theme": { "$ref": "#/$defs/theme" },
    "runtimePolicy": { "$ref": "#/$defs/runtimePolicy" },
    "extensionRefs": { "$ref": "#/$defs/extensionRefs" },
    "publishConfig": { "$ref": "#/$defs/publishConfig" },
    "createdAt": { "type": "string" },
    "updatedAt": { "type": "string" },
    "activePageId": false,
    "pageStack": false,
    "dialogStack": false,
    "drillStacks": false,
    "linkageState": false,
    "dialogGeometry": false,
    "interactionSessionId": false,
    "interactionEpoch": false
  },
  "additionalProperties": false,
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "safeStyleToken": { "type": "string", "maxLength": 500, "pattern": "^(?!.*(?:[uU][rR][lL]\\s*\\(|[vV][aA][rR]\\s*\\(|[eE][xX][pP][rR][eE][sS][sS][iI][oO][nN]\\s*\\(|@[iI][mM][pP][oO][rR][tT]|[jJ][aA][vV][aA][sS][cC][rR][iI][pP][tT]:|[dD][aA][tT][aA]:|[;{}'\"\\\\])).*$" },
    "canvas": {
      "type": "object",
      "required": ["width", "height", "background", "showGrid", "gridSize"],
      "properties": {
        "width": { "type": "number", "minimum": 320, "maximum": 1920 },
        "height": { "type": "number", "minimum": 240, "maximum": 6000 },
        "background": { "$ref": "#/$defs/safeStyleToken" },
        "showGrid": { "type": "boolean" },
        "gridSize": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": true
    },
    "titleStyle": {
      "type": "object",
      "required": ["show", "fontSize", "color", "fontWeight", "align"],
      "properties": {
        "show": { "type": "boolean" },
        "fontSize": { "type": "number", "exclusiveMinimum": 0 },
        "color": { "$ref": "#/$defs/safeStyleToken" },
        "fontWeight": { "type": "number" },
        "align": { "enum": ["left", "center", "right"] }
      },
      "additionalProperties": true
    },
    "page": {
      "type": "object",
      "required": ["id", "name", "code", "order", "type", "canvas", "titleStyle", "controls", "components", "pageEvents"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "code": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "order": { "type": "integer", "minimum": 1 },
        "type": { "enum": ["standard", "dialog"] },
        "canvas": { "$ref": "#/$defs/canvas" },
        "titleStyle": { "$ref": "#/$defs/titleStyle" },
        "controls": { "type": "array", "items": { "$ref": "#/$defs/parameterControl" } },
        "components": { "type": "array", "items": { "$ref": "#/$defs/component" } },
        "pageEvents": { "type": "array", "items": { "$ref": "#/$defs/eventBinding" } }
      },
      "additionalProperties": true
    },
    "component": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "type": { "enum": ["kpi", "line", "bar", "pie", "table", "text", "image", "icon", "decoration", "map", "tabs", "income", "outpatient", "ranking", "bed", "area", "combo", "scatter", "bubble"] },
        "textConfig": { "$ref": "#/$defs/textConfig" },
        "imageConfig": { "$ref": "#/$defs/imageConfig" },
        "iconConfig": { "$ref": "#/$defs/iconConfig" },
        "decorationConfig": { "$ref": "#/$defs/decorationConfig" },
        "mapConfig": { "$ref": "#/$defs/mapConfig" },
        "tableConfig": { "$ref": "#/$defs/tableConfig" },
        "kpiConfig": { "type": "object", "properties": { "progressColor": { "$ref": "#/$defs/safeStyleToken" } }, "additionalProperties": true },
        "tabsConfig": { "type": "object", "properties": { "items": { "type": "array", "items": { "type": "object", "properties": { "background": { "$ref": "#/$defs/safeStyleToken" } }, "additionalProperties": true } } }, "additionalProperties": true },
        "events": { "type": "array", "items": { "$ref": "#/$defs/eventBinding" } }
      },
      "additionalProperties": true
    },
    "tableConditionalRule": {
      "type": "object",
      "required": ["id", "field", "operator"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "field": { "$ref": "#/$defs/nonEmptyString" },
        "operator": { "enum": ["eq", "ne", "gt", "gte", "lt", "lte", "contains", "in", "between", "isNull", "notNull"] },
        "value": { "$ref": "#/$defs/jsonValue" },
        "backgroundColor": { "$ref": "#/$defs/safeStyleToken" },
        "textColor": { "$ref": "#/$defs/safeStyleToken" },
        "badge": { "enum": ["normal", "warning", "danger"] }
      },
      "additionalProperties": false
    },
    "tableConfig": {
      "type": "object",
      "required": ["columns"],
      "properties": {
        "columns": { "type": "array" },
        "striped": { "type": "boolean" },
        "showHeader": { "type": "boolean" },
        "fixedHeader": { "type": "boolean" },
        "pagination": {
          "type": "object",
          "required": ["enabled", "mode", "pageSize", "showTotal"],
          "properties": {
            "enabled": { "type": "boolean" },
            "mode": { "enum": ["client", "server"] },
            "pageSize": { "type": "integer", "minimum": 1, "maximum": 200 },
            "showTotal": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "conditionalRules": { "type": "array", "items": { "$ref": "#/$defs/tableConditionalRule" } }
      },
      "additionalProperties": true
    },
    "textConfig": {
      "type": "object", "required": ["content", "color", "fontSize", "fontWeight", "align", "verticalAlign", "lineHeight"],
      "properties": { "content": { "type": "string", "maxLength": 20000 }, "color": { "$ref": "#/$defs/safeStyleToken" }, "fontSize": { "type": "number", "minimum": 8, "maximum": 120 }, "fontWeight": { "type": "number", "minimum": 100, "maximum": 900 }, "align": { "enum": ["left", "center", "right"] }, "verticalAlign": { "enum": ["top", "center", "bottom"] }, "lineHeight": { "type": "number", "minimum": 1, "maximum": 3 } }, "additionalProperties": false
    },
    "imageConfig": {
      "type": "object", "required": ["source", "alt", "objectFit", "opacity"],
      "properties": { "source": { "type": "string", "pattern": "^(|data:image/(png|jpeg|webp|gif);base64,[A-Za-z0-9+/=]+)$" }, "alt": { "type": "string", "maxLength": 500 }, "objectFit": { "enum": ["contain", "cover", "fill"] }, "opacity": { "type": "number", "minimum": 0, "maximum": 1 } }, "additionalProperties": false
    },
    "iconConfig": {
      "type": "object", "required": ["name", "color", "size", "strokeWidth"],
      "properties": { "name": { "enum": ["hospital", "activity", "warning", "check", "location", "users"] }, "color": { "$ref": "#/$defs/safeStyleToken" }, "size": { "type": "number", "minimum": 12, "maximum": 256 }, "strokeWidth": { "type": "number", "minimum": 1, "maximum": 4 } }, "additionalProperties": false
    },
    "decorationConfig": {
      "type": "object", "required": ["shape", "fill", "borderColor", "borderWidth", "borderRadius", "direction"],
      "properties": { "shape": { "enum": ["rectangle", "line", "divider"] }, "fill": { "$ref": "#/$defs/safeStyleToken" }, "borderColor": { "$ref": "#/$defs/safeStyleToken" }, "borderWidth": { "type": "number", "minimum": 0, "maximum": 20 }, "borderRadius": { "type": "number", "minimum": 0, "maximum": 100 }, "direction": { "enum": ["horizontal", "vertical"] } }, "additionalProperties": false
    },
    "geoJsonGeometry": {
      "type": "object", "required": ["type", "coordinates"], "properties": { "type": { "enum": ["Polygon", "MultiPolygon"] }, "coordinates": { "type": "array", "minItems": 1 } }, "additionalProperties": false
    },
    "mapConfig": {
      "type": "object",
      "required": ["regionCodeProperty", "regionNameProperty", "regionCodeField", "valueField", "longitudeField", "latitudeField", "pointLabelField", "emptyColor", "lowColor", "highColor", "borderColor", "pointColor", "showLegend", "showPoints"],
      "properties": {
        "geoJson": {
          "type": "object", "required": ["type", "features"],
          "properties": {
            "type": { "const": "FeatureCollection" },
            "features": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["type", "properties", "geometry"], "properties": { "type": { "const": "Feature" }, "properties": { "type": "object" }, "geometry": { "$ref": "#/$defs/geoJsonGeometry" } }, "additionalProperties": false } }
          },
          "additionalProperties": false
        },
        "regionCodeProperty": { "$ref": "#/$defs/nonEmptyString" }, "regionNameProperty": { "$ref": "#/$defs/nonEmptyString" },
        "regionCodeField": { "$ref": "#/$defs/nonEmptyString" }, "valueField": { "$ref": "#/$defs/nonEmptyString" },
        "longitudeField": { "$ref": "#/$defs/nonEmptyString" }, "latitudeField": { "$ref": "#/$defs/nonEmptyString" }, "pointLabelField": { "$ref": "#/$defs/nonEmptyString" },
        "emptyColor": { "$ref": "#/$defs/safeStyleToken" }, "lowColor": { "$ref": "#/$defs/safeStyleToken" }, "highColor": { "$ref": "#/$defs/safeStyleToken" }, "borderColor": { "$ref": "#/$defs/safeStyleToken" }, "pointColor": { "$ref": "#/$defs/safeStyleToken" },
        "showLegend": { "type": "boolean" }, "showPoints": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "valueExpression": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "parameterId"],
          "properties": {
            "kind": { "const": "parameter" },
            "parameterId": { "$ref": "#/$defs/nonEmptyString" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "path"],
          "properties": {
            "kind": { "const": "eventField" },
            "path": { "$ref": "#/$defs/nonEmptyString" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "fixed" },
            "value": { "$ref": "#/$defs/jsonValue" }
          },
          "additionalProperties": false
        }
      ]
    },
    "jsonValue": {
      "anyOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        { "type": "array", "items": { "$ref": "#/$defs/jsonValue" } },
        { "type": "object", "additionalProperties": { "$ref": "#/$defs/jsonValue" } }
      ]
    },
    "eventCondition": {
      "type": "object",
      "required": ["left", "operator"],
      "properties": {
        "left": { "$ref": "#/$defs/valueExpression" },
        "operator": { "enum": ["eq", "ne", "in", "notIn", "isEmpty", "notEmpty"] },
        "right": { "$ref": "#/$defs/valueExpression" }
      },
      "additionalProperties": false
    },
    "setParameterAction": {
      "type": "object",
      "required": ["id", "type", "assignments"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "type": { "const": "setParameter" },
        "assignments": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["parameterId", "value"],
            "properties": {
              "parameterId": { "$ref": "#/$defs/nonEmptyString" },
              "value": { "$ref": "#/$defs/valueExpression" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "refreshAction": {
      "type": "object",
      "required": ["id", "type", "target"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "type": { "const": "refresh" },
        "target": {
          "oneOf": [
            {
              "type": "object",
              "required": ["kind", "componentIds"],
              "properties": {
                "kind": { "const": "components" },
                "componentIds": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "$ref": "#/$defs/nonEmptyString" },
                  "uniqueItems": true
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": ["kind", "pageId"],
              "properties": {
                "kind": { "const": "page" },
                "pageId": { "$ref": "#/$defs/nonEmptyString" }
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "interactionAssignment": {
      "type": "object",
      "required": ["parameterId", "value"],
      "properties": {
        "parameterId": { "$ref": "#/$defs/nonEmptyString" },
        "value": { "$ref": "#/$defs/valueExpression" }
      },
      "additionalProperties": false
    },
    "parameterIdArray": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/nonEmptyString" },
      "uniqueItems": true
    },
    "navigatePageAction": {
      "type": "object",
      "required": ["id", "type", "pageId", "history"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "type": { "const": "navigatePage" },
        "pageId": { "$ref": "#/$defs/nonEmptyString" },
        "history": { "enum": ["push", "replace"] },
        "assignments": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/interactionAssignment" } }
      },
      "additionalProperties": false
    },
    "pageBackAction": {
      "type": "object",
      "required": ["id", "type"],
      "properties": { "id": { "$ref": "#/$defs/nonEmptyString" }, "type": { "const": "pageBack" } },
      "additionalProperties": false
    },
    "openPageWindowAction": {
      "type": "object",
      "required": ["id", "type", "pageId"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "type": { "const": "openPageWindow" },
        "pageId": { "$ref": "#/$defs/nonEmptyString" },
        "carryParameterIds": { "$ref": "#/$defs/parameterIdArray" }
      },
      "additionalProperties": false
    },
    "dialogPresentation": {
      "type": "object",
      "required": ["width", "height", "draggable", "resizable", "closeOnEscape", "closeOnBackdrop"],
      "properties": {
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "minWidth": { "type": "number", "exclusiveMinimum": 0 },
        "minHeight": { "type": "number", "exclusiveMinimum": 0 },
        "maxWidth": { "type": "number", "exclusiveMinimum": 0 },
        "maxHeight": { "type": "number", "exclusiveMinimum": 0 },
        "draggable": { "type": "boolean" },
        "resizable": { "type": "boolean" },
        "closeOnEscape": { "type": "boolean" },
        "closeOnBackdrop": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "openDialogAction": {
      "type": "object",
      "required": ["id", "type", "pageId", "presentation"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "type": { "const": "openDialog" },
        "pageId": { "$ref": "#/$defs/nonEmptyString" },
        "presentation": { "$ref": "#/$defs/dialogPresentation" },
        "assignments": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/interactionAssignment" } }
      },
      "additionalProperties": false
    },
    "closeDialogAction": {
      "type": "object",
      "required": ["id", "type"],
      "properties": { "id": { "$ref": "#/$defs/nonEmptyString" }, "type": { "const": "closeDialog" } },
      "additionalProperties": false
    },
    "applyLinkageAction": {
      "type": "object",
      "required": ["id", "type", "assignments", "targetComponentIds"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "type": { "const": "applyLinkage" },
        "assignments": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/interactionAssignment" } },
        "targetComponentIds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonEmptyString" }, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "clearLinkageAction": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "type": { "const": "clearLinkage" },
        "linkageActionId": { "$ref": "#/$defs/nonEmptyString" }
      },
      "additionalProperties": false
    },
    "drillAction": {
      "type": "object",
      "required": ["id", "type", "pathId"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "type": { "enum": ["drillDown", "drillBack", "clearDrill"] },
        "pathId": { "$ref": "#/$defs/nonEmptyString" }
      },
      "additionalProperties": false
    },
    "openExternalLinkAction": {
      "type": "object",
      "required": ["id", "type", "url"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "type": { "const": "openExternalLink" },
        "url": { "$ref": "#/$defs/nonEmptyString" },
        "carryParameterIds": { "$ref": "#/$defs/parameterIdArray" }
      },
      "additionalProperties": false
    },
    "actionDefinition": {
      "oneOf": [
        { "$ref": "#/$defs/setParameterAction" },
        { "$ref": "#/$defs/refreshAction" },
        { "$ref": "#/$defs/navigatePageAction" },
        { "$ref": "#/$defs/pageBackAction" },
        { "$ref": "#/$defs/openPageWindowAction" },
        { "$ref": "#/$defs/openDialogAction" },
        { "$ref": "#/$defs/closeDialogAction" },
        { "$ref": "#/$defs/applyLinkageAction" },
        { "$ref": "#/$defs/clearLinkageAction" },
        { "$ref": "#/$defs/drillAction" },
        { "$ref": "#/$defs/openExternalLinkAction" }
      ]
    },
    "eventBinding": {
      "type": "object",
      "required": ["id", "enabled", "event", "actions"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "enabled": { "type": "boolean" },
        "event": { "enum": ["click", "doubleClick", "valueChange", "rowClick", "pageEnter"] },
        "conditions": { "type": "array", "items": { "$ref": "#/$defs/eventCondition" } },
        "actions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/actionDefinition" } },
        "debounceMs": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "parameterOption": {
      "type": "object",
      "required": ["label", "value"],
      "properties": {
        "label": { "$ref": "#/$defs/nonEmptyString" },
        "value": {}
      },
      "additionalProperties": false
    },
    "parameterSource": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "options"],
          "properties": {
            "kind": { "const": "static" },
            "options": { "type": "array", "items": { "$ref": "#/$defs/parameterOption" } }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "dictionaryCode"],
          "properties": {
            "kind": { "const": "dictionary" },
            "dictionaryCode": { "type": "string", "pattern": "^builtin\\.[a-z][A-Za-z0-9]*$" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "systemCode"],
          "properties": {
            "kind": { "const": "system" },
            "systemCode": { "$ref": "#/$defs/nonEmptyString" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "datasetId", "valueField", "labelField"],
          "properties": {
            "kind": { "const": "dataset" },
            "datasetId": { "$ref": "#/$defs/nonEmptyString" },
            "valueField": { "$ref": "#/$defs/nonEmptyString" },
            "labelField": { "$ref": "#/$defs/nonEmptyString" },
            "dependencies": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["parameterId", "datasetParameterCode"],
                "properties": {
                  "parameterId": { "$ref": "#/$defs/nonEmptyString" },
                  "datasetParameterCode": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "position": {
      "type": "object",
      "required": ["x", "y", "width", "height", "zIndex"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "zIndex": { "type": "number" }
      },
      "additionalProperties": false
    },
    "parameterControl": {
      "type": "object",
      "required": ["id", "type", "parameterIds", "position", "styleConfig", "interaction"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "type": { "enum": ["input", "buttonGroup", "singleSelect", "multiSelect", "date", "dateRange"] },
        "parameterIds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmptyString" },
          "uniqueItems": true
        },
        "position": { "$ref": "#/$defs/position" },
        "styleConfig": { "type": "object" },
        "events": { "type": "array", "items": { "$ref": "#/$defs/eventBinding" } },
        "interaction": {
          "type": "object",
          "required": ["submitMode", "clearable"],
          "properties": {
            "submitMode": { "enum": ["immediate", "manual"] },
            "clearable": { "type": "boolean" },
            "cascadeFrom": {
              "type": "array",
              "items": { "$ref": "#/$defs/nonEmptyString" },
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "parameterValidation": {
      "type": "object",
      "properties": {
        "allowEmpty": { "type": "boolean" },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "pattern": { "type": "string" }
      },
      "additionalProperties": false
    },
    "parameter": {
      "type": "object",
      "required": ["id", "code", "name", "type", "scope", "required", "source"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "code": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "type": { "enum": ["string", "number", "date", "dateRange", "singleSelect", "multiSelect"] },
        "scope": { "const": "application" },
        "pageId": { "type": "string" },
        "required": { "type": "boolean" },
        "defaultValue": {},
        "source": { "$ref": "#/$defs/parameterSource" },
        "validation": { "$ref": "#/$defs/parameterValidation" },
        "aliases": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      },
      "additionalProperties": true
    },
    "drillPath": {
      "type": "object",
      "required": ["id", "name", "levels"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "levels": {
          "type": "array",
          "minItems": 2,
          "maxItems": 100,
          "items": {
            "type": "object",
            "required": ["id", "label", "field", "parameterId"],
            "properties": {
              "id": { "$ref": "#/$defs/nonEmptyString" },
              "label": { "$ref": "#/$defs/nonEmptyString" },
              "field": { "$ref": "#/$defs/nonEmptyString" },
              "parameterId": { "$ref": "#/$defs/nonEmptyString" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "theme": {
      "type": "object",
      "required": ["id", "tokens"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "tokens": {
          "type": "object",
          "properties": {
            "canvasBackground": { "$ref": "#/$defs/safeStyleToken" }, "panelBackground": { "$ref": "#/$defs/safeStyleToken" }, "panelBorder": { "$ref": "#/$defs/safeStyleToken" },
            "panelRadius": { "type": "number", "minimum": 0, "maximum": 80 }, "panelShadow": { "$ref": "#/$defs/safeStyleToken" },
            "textPrimary": { "$ref": "#/$defs/safeStyleToken" }, "textSecondary": { "$ref": "#/$defs/safeStyleToken" },
            "chartPalette": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/safeStyleToken" } },
            "statusNormal": { "$ref": "#/$defs/safeStyleToken" }, "statusWarning": { "$ref": "#/$defs/safeStyleToken" }, "statusDanger": { "$ref": "#/$defs/safeStyleToken" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "runtimePolicy": {
      "type": "object",
      "required": ["previewScaleMode", "allowScroll", "parameterPersistence", "maxEventDepth"],
      "properties": {
        "previewScaleMode": { "enum": ["fit", "width", "actual"] },
        "allowScroll": { "type": "boolean" },
        "parameterPersistence": { "enum": ["none", "session", "url"] },
        "maxEventDepth": { "type": "integer", "minimum": 1, "maximum": 100 }
      },
      "additionalProperties": false
    },
    "extensionRefs": {
      "type": "object",
      "properties": {
        "permissionPolicyRef": { "type": "string" },
        "queryCachePolicyRef": { "type": "string" },
        "semanticLayerRef": { "type": "string" },
        "algorithmProviderRefs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      },
      "additionalProperties": true
    },
    "publishConfig": {
      "type": "object",
      "required": ["status", "entryPageId", "access"],
      "properties": {
        "status": { "enum": ["draft", "published", "archived"] },
        "publishedVersion": { "type": "integer", "minimum": 1 },
        "entryPageId": { "$ref": "#/$defs/nonEmptyString" },
        "access": { "enum": ["private", "authenticated", "public"] },
        "publishedAt": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
